# --- OpenRouter (LLM provider) ---
OPENROUTER_API_KEY=sk-or-v1-...

# Base URL of the LLM provider. Leave it unset to talk to OpenRouter
# directly. Point it at a Cloudflare AI Gateway provider-native endpoint
# to route every call through the gateway (cache, rate limiting, DLP,
# per-call cost logs):
# OPENROUTER_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY>/openrouter

# --- Cloudflare AI Gateway (optional) ---
# Only required when the gateway has Authenticated Gateway enabled.
# Create it in AI Gateway > <gateway> > Settings > Create authentication
# token (permission: AI Gateway Run). Without it the gateway answers
# 401 AiGatewayError before the provider is ever called.
# CF_AIG_TOKEN=...

# --- LangSmith (optional tracing) ---
# Set LANGSMITH_TRACING=true to enable; omit or set to false to disable.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=medical-agent

# --- Google Calendar (service account) ---
# Paste the full service account JSON as a single line (see README for how
# to create one).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...","...":"..."}

# --- Admin API ---
# Protects POST/DELETE /admin/professionals/{calendar_id}.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=change-me
